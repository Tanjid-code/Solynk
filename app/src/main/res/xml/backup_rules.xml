<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Include user preferences -->
    <include domain="sharedpref" path="SoloConnectPrefs.xml" />

    <!-- Exclude sensitive data -->
    <exclude domain="sharedpref" path="privateKey" />
    <exclude domain="sharedpref" path="passwordHash" />

    <!-- Include database if any -->
    <include domain="database" path="." />

    <!-- Exclude cache -->
    <exclude domain="file" path="cache/" />
</full-backup-content>