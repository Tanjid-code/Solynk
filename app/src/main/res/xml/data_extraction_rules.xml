<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Allow backup of user preferences -->
        <include domain="sharedpref" path="SoloConnectPrefs.xml" />

        <!-- Exclude sensitive encryption keys -->
        <exclude domain="sharedpref" path="privateKey" />
        <exclude domain="sharedpref" path="passwordHash" />
    </cloud-backup>

    <device-transfer>
        <!-- Allow transfer of user preferences -->
        <include domain="sharedpref" path="SoloConnectPrefs.xml" />

        <!-- Exclude sensitive data from device transfer -->
        <exclude domain="sharedpref" path="privateKey" />
        <exclude domain="sharedpref" path="passwordHash" />
    </device-transfer>
</data-extraction-rules>